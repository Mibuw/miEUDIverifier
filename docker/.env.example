# Secrets for docker-compose.de-backend.yml — copy to .env next to it and fill in.
#
#   cp docker/.env.example docker/.env
#
# Both values belong to the verifier BACKEND, which is what signs the authorization
# request object. Nothing of this is configured in the app or in the
# miEUDIverifier.Core NuGet package; a client only names an intended use.
#
# Keep the filled-in .env out of version control (it is already covered by
# .gitignore) and readable by nobody else:  chmod 600 docker/.env


# ── Access certificate ────────────────────────────────────────────────────────
# Password of the PKCS#12 keystore holding your private key, the SPRIND-issued
# RP access certificate and its CA chain. The compose file uses it for both
# VERIFIER_ACCESS_CERTIFICATE_KEYSTORE_PASSWORD and _PASSWORD, so the keystore and
# the key entry have to share one password.
#
# Build the keystore from what the registrar hands you:
#
#   openssl pkcs12 -export \
#     -inkey access-certificate-private-key.pem \
#     -in    access-certificate-<id>.pem \
#     -certfile ac1.pem \
#     -name verifier \
#     -out certs-de/keystore.p12
#
# -name must match VERIFIER_ACCESS_CERTIFICATE_ALIAS ("verifier"), or the backend
# will not find the key.
#
# After every reissue, recompute VERIFIER_ORIGINALCLIENTID in the compose file —
# with the x509_hash prefix the client_id IS the certificate's hash:
#
#   openssl x509 -in access-certificate-<id>.pem -outform DER \
#     | openssl dgst -sha256 -binary | basenc --base64url | tr -d '='
#
# A stale value fails with the same "Could not trust certificate chain" the wallet
# reports for a genuinely untrusted chain.
DE_KEYSTORE_PASSWORD=


# ── Registration certificate ──────────────────────────────────────────────────
# The registration certificate itself, as the JWT the registrar issues — one long
# line, three base64url parts separated by dots, no quotes and no line breaks.
# It decides which attributes you may ask for; requesting more makes the wallet
# abort before the consent screen.
#
# It must spell its claims one entry per attribute (mso_mdoc entries carrying the
# namespace as a first path segment). See docs/german-pid-presentation.md.
#
# The JWT is not a secret — it travels to the wallet as verifier_info in every
# request object — but it lives here because it is too long to keep inline.
DE_REGISTRATION_CERTIFICATE=
