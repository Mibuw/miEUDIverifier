<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both, because the package would otherwise hand a net10.0 application the net8.0 asset,
         which fails at RUNTIME rather than at build: X509CertificateLoader comes from
         Microsoft.Bcl.Cryptography on net8.0, and that assembly is not there to load under
         net10.0. A fresh `dotnet new web` on the current SDK produces exactly that project.
         Tessio.Verifier ships both frameworks, so this only follows it. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>miEUDIverifier.Core</AssemblyName>
    <RootNamespace>miEUDIverifier</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Description & other NuGet metadata: see Directory.Build.props -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The in-process verification path hosts HTTP endpoints the wallet calls (the JAR and the
         wallet callback), so the package needs ASP.NET Core. A console or worker host that only
         consumes the backend path still works: the framework reference resolves from the shared
         framework and adds nothing to the output. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Verifies presentations in process, so the German path needs no verifier backend container.
         AspNetCore pulls in Core, Core.Mdoc, OpenId4Vp and Trust. -->
    <PackageReference Include="Tessio.Verifier.AspNetCore" Version="0.30.2" />
    <!-- QR code generation -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <!-- DI / Options / Logging (Abstractions) -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project>
