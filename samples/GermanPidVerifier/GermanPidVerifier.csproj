<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GermanPidVerifier</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only dependency. Configuration, dependency injection and logging come
         with the web SDK, so there is no other plumbing to add. -->
    <PackageReference Include="miEUDIverifier.Core" Version="2.0.1" />
  </ItemGroup>

</Project>
