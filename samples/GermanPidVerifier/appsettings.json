{
  "VerifierSettings": {
    // Your own verifier backend, the one holding the SPRIND access certificate.
    // There is no public one to point at — see ../README.md for running it locally
    // or reaching a deployed one through an SSH tunnel.
    "BackendUrl": "http://localhost:8080",

    // The id you gave the intended use on that backend
    // (VERIFIER_INTENDEDUSES_<n>_ID), which selects the registration certificate.
    "IntendedUseId": "pos-pid",

    // The German wallet requires an encrypted response; Program.cs sets this per
    // transaction as well, so the two cannot drift apart.
    "ResponseMode": "direct_post.jwt",

    "AuthorizationRequestScheme": "openid4vp",
    "JarMode": "by_reference",
    "RequestUriMethod": "get",

    "PollIntervalSeconds": 3,
    "PollTimeoutSeconds": 120

    // The attribute set, the vct values and the credential formats are deliberately
    // NOT configured here. The .NET configuration binder APPENDS to a list that
    // already carries defaults, so a JSON array would ask for the defaults too —
    // and a request that reaches past the registration certificate makes the wallet
    // abort. Program.cs sets them through TransactionOptions, which replaces.
  }
}
