{
  // The web server itself. Everything below "VerifierSettings" is read by
  // AddMiEUDIverifier(builder.Configuration) in Program.cs.
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5080" }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "miEUDIverifier": "Information"
    }
  },

  "VerifierSettings": {
    // Your own verifier backend, the one holding the SPRIND access certificate.
    // There is no public one to point at — see ../README.md for running it locally
    // or reaching a deployed one through an SSH tunnel.
    "BackendUrl": "http://localhost:8080",

    // The id you gave the intended use on that backend
    // (VERIFIER_INTENDEDUSES_<n>_ID), which selects the registration certificate.
    "IntendedUseId": "pos-pid",

    // The German wallet requires an encrypted response; Program.cs sets this per
    // transaction as well, so the two cannot drift apart.
    "ResponseMode": "direct_post.jwt",

    "AuthorizationRequestScheme": "openid4vp",
    "JarMode": "by_reference",
    "RequestUriMethod": "get",

    "PollIntervalSeconds": 3,
    "PollTimeoutSeconds": 120

    // No certificate appears in this file, and none is missing. There is no
    // keystore path, no private key, no password and no certificate JWT to fill
    // in here — adding such keys would do nothing, because the library does not
    // read them. Both certificates belong to the verifier BACKEND, which is what
    // signs the request object.
    //
    // This is what actually has to be filled in, and where. In docker/.env
    // (template: docker/.env.example) — the two values, empty here:
    //
    //     DE_KEYSTORE_PASSWORD=
    //     DE_REGISTRATION_CERTIFICATE=
    //
    // which docker-compose.de-backend.yml hands to the backend as:
    //
    //     VERIFIER_ACCESS_CERTIFICATE_KEYSTORE: "file:///certs/keystore.p12"
    //     VERIFIER_ACCESS_CERTIFICATE_KEYSTORE_PASSWORD: "${DE_KEYSTORE_PASSWORD}"
    //     VERIFIER_ACCESS_CERTIFICATE_ALIAS: "verifier"
    //     VERIFIER_INTENDEDUSES_0_ID: "pos-pid"
    //     VERIFIER_INTENDEDUSES_0_REGISTRATIONCERTIFICATE: "${DE_REGISTRATION_CERTIFICATE}"
    //
    // plus the keystore file itself, mounted read-only:
    //
    //     volumes:
    //       - ./certs-de/keystore.p12:/certs/keystore.p12:ro
    //
    // The only link from here is "IntendedUseId" above — it matches
    // VERIFIER_INTENDEDUSES_0_ID and is a NAME, not a certificate. The access
    // certificate reaches this process in exactly one shape: the client_id that
    // comes back with the transaction, which under x509_hash IS its SHA-256.

    // The attribute set, the vct values and the credential formats are deliberately
    // NOT configured here. The .NET configuration binder APPENDS to a list that
    // already carries defaults, so a JSON array would ask for the defaults too —
    // and a request that reaches past the registration certificate makes the wallet
    // abort. Program.cs sets them through TransactionOptions, which replaces.
  }
}
