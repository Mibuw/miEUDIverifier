{
  "VerifierSettings": {
    "BackendUrl": "https://verifier-backend.eudiw.dev",

    "IntendedUseId": "TEST-01",

    "ResponseMode": "direct_post.jwt",
    "AuthorizationRequestScheme": "openid4vp",
    "JarMode": "by_reference",
    "RequestUriMethod": "get",

    "PollIntervalSeconds": 3,
    "PollTimeoutSeconds": 120

    // Deliberately NOT setting PidClaims here. The .NET configuration binder APPENDS to a
    // list that already has defaults, so repeating the three default claims would request
    // six. Override the attribute set through TransactionOptions.PidClaims instead — see
    // Program.cs — or give the list a per-backend home where it starts out empty.
  }
}
